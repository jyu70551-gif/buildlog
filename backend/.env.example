# 비밀값 없이 항목 이름만 적는 예시 파일입니다. 실제 값은 .env에 넣고 .env는 Git에 올리지 않습니다.

# 서버 요청을 허용할 화면 주소
FRONTEND_ORIGIN=http://localhost:5173

# 데이터베이스 연결 주소 (비워 두면 database/buildlog.sqlite3 를 사용)
# 실제 서비스(Supabase)에서는 Supabase 연결 주소로 바꾼다.
# DATABASE_URL=

# 로그인 확인 값을 만들 때 쓰는 비밀 키. 길고 무작위인 값을 .env에 직접 만들어 넣는다.
# 만드는 방법: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
